meta {
  name: GitHub Webhook - Issues Event
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/webhook/github
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-github-event: issues
  x-hub-signature-256: sha256=your-hmac-signature-here
}

body:json {
  {
    "action": "opened",
    "issue": {
      "id": 1234567890,
      "number": 42,
      "title": "Bug: Something is broken",
      "state": "open",
      "html_url": "https://github.com/owner/repo/issues/42",
      "body": "This is the issue description.",
      "assignees": [
        {
          "login": "github-username",
          "id": 9876543
        }
      ],
      "created_at": "2025-01-01T00:00:00Z",
      "updated_at": "2025-01-01T00:00:00Z"
    },
    "repository": {
      "id": 111222333,
      "name": "repo",
      "full_name": "owner/repo",
      "html_url": "https://github.com/owner/repo",
      "owner": {
        "login": "owner"
      }
    },
    "sender": {
      "login": "github-username"
    }
  }
}

docs {
  Simulates a GitHub webhook push for an "issues" event.
  
  Required Headers:
  - x-github-event: The GitHub event type (e.g. issues, push, ping)
  - x-hub-signature-256: HMAC SHA256 signature of the raw body using your webhook secret.
    Format: sha256=<hex-digest>
  
  Note: The HMAC signature must match the raw request body using your WEBHOOK_SECRET.
  For local testing, you can temporarily disable signature validation in WebhookService,
  or use a script to generate the correct signature.
}
