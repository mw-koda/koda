meta {
  name: GitHub Webhook - Issue Closed Event
  type: http
  seq: 4
}

post {
  url: http://localhost:3000/webhook/github
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-github-event: issues
  x-hub-signature-256: sha256=your-hmac-signature-here
}

body:json {
  {
    "action": "closed",
    "issue": {
      "id": 1234567890,
      "number": 42,
      "title": "Bug: Something is broken",
      "state": "closed",
      "html_url": "https://github.com/owner/repo/issues/42",
      "body": "This is the issue description.",
      "assignees": [
        {
          "login": "intern-github-username",
          "id": 9876543
        }
      ],
      "created_at": "2025-01-01T00:00:00Z",
      "updated_at": "2025-01-03T00:00:00Z",
      "closed_at": "2025-01-03T00:00:00Z"
    },
    "repository": {
      "id": 111222333,
      "name": "repo",
      "full_name": "owner/repo",
      "html_url": "https://github.com/owner/repo",
      "owner": {
        "login": "owner"
      }
    },
    "sender": {
      "login": "intern-github-username"
    }
  }
}

docs {
  Simulates a GitHub webhook event when an issue is closed.
  This should trigger issue state update to "closed" in the database.
  
  Required Headers:
  - x-github-event: issues
  - x-hub-signature-256: HMAC SHA256 signature (sha256=<hex-digest>)
}
