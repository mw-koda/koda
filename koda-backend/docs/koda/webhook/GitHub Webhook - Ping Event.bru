meta {
  name: GitHub Webhook - Ping Event
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/webhook/github
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-github-event: ping
  x-hub-signature-256: sha256=your-hmac-signature-here
}

body:json {
  {
    "zen": "Approachable is better than simple.",
    "hook_id": 123456,
    "hook": {
      "type": "Repository",
      "id": 123456,
      "name": "web",
      "active": true,
      "events": ["issues", "push"],
      "config": {
        "content_type": "json",
        "url": "http://localhost:3000/webhook/github"
      }
    },
    "repository": {
      "id": 111222333,
      "name": "repo",
      "full_name": "owner/repo",
      "html_url": "https://github.com/owner/repo",
      "owner": {
        "login": "owner"
      }
    }
  }
}

docs {
  Simulates the ping event GitHub sends when a webhook is first created.
  Use this to verify your webhook endpoint is reachable and responding correctly.
  
  Required Headers:
  - x-github-event: ping
  - x-hub-signature-256: HMAC SHA256 signature (sha256=<hex-digest>)
}
